# Deliberate source allowlist. Never add runtime/configuration folders by force.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/LICENSE
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/host/
!/desktop/
!/android/
!/tools/
!/tests/
!/docs/
!/.github/
**/bin/
**/obj/
**/build/
**/gradle-build/
**/.gradle/
**/.idea/
**/.vs/
**/__pycache__/
**/local.properties
**/google-services.json
**/service-account*.json
**/*serviceAccount*.json
**/*credentials*.json
**/*.dpapi
**/*.p12
**/*.pfx
**/*.pem
**/*.key
**/*.jks
**/*.keystore
**/password*.txt
**/.env
**/.env.*
**/*.apk
**/*.aab
**/*.exe
**/*.dll
**/*.pdb
**/*.log
**/*.pid
**/*.jsonl
**/*.db
**/*.sqlite*
**/attachments/

# Local release reports are not required for building or running Desktop.
/desktop/releases/*.json
!/desktop/releases/retained-release-identities.json
/desktop/release-*.json

